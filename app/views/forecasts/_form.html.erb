<%= form_with url: forecast_path, method: :get, class: "flex flex-col gap-2" do |form| %>
  <%= form.label :address, t(".address_label"), class: "text-sm font-medium text-slate-700" %>
  <div class="flex flex-col gap-2 sm:flex-row">
    <%= form.text_field :address,
                        value: address,
                        placeholder: t(".address_placeholder"),
                        required: true,
                        autofocus: address.blank?,
                        class: "min-w-0 w-full flex-1 rounded-lg border border-slate-300 bg-white px-4 py-2.5 shadow-sm placeholder:text-slate-400 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/30" %>
    <%= form.submit t(".submit"),
                    name: nil,
                    data: { turbo_submits_with: t(".submitting") },
                    class: "cursor-pointer rounded-lg bg-sky-600 px-5 py-2.5 font-medium text-white shadow-sm hover:bg-sky-700 disabled:cursor-wait disabled:opacity-70" %>
  </div>
<% end %>
