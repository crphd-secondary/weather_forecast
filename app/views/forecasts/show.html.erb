<%= render "form", address: @search.address %>

<%= turbo_frame_tag "forecast", class: "mt-8 block transition-opacity aria-busy:opacity-50" do %>
  <% if @result.success? %>
    <section class="forecast overflow-hidden rounded-lg bg-white ring-1 ring-slate-200">
      <div class="p-4 sm:p-6">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <h2 class="break-words text-base font-semibold leading-relaxed"><%= @result.location.formatted_address %></h2>
            <p class="mt-1 text-sm text-slate-500"><%= t(".zip_code_html", zip_code: tag.strong(@result.location.zip_code, class: "font-medium text-slate-700")) %></p>
          </div>

          <% if @result.cached? %>
            <span class="badge cached shrink-0 rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700"><%= t(".cached") %></span>
          <% else %>
            <span class="badge live shrink-0 rounded-full bg-emerald-100 px-3 py-1 text-xs font-medium text-emerald-800"><%= t(".live") %></span>
          <% end %>
        </div>

        <p class="current mt-6 flex items-baseline gap-3">
          <strong class="text-6xl font-light tracking-tight tabular-nums"><%= t(".temperature", degrees: @result.forecast.current_temperature.round) %></strong>
          <span class="text-slate-500"><%= t(".current") %></span>
        </p>

        <p class="source mt-2 text-xs text-slate-500">
          <% if @result.cached? %>
            <%= t(".cached_since", time: time_ago_in_words(@result.fetched_at)) %>
          <% else %>
            <%= t(".live_since") %>
          <% end %>
        </p>
      </div>

      <table class="w-full text-sm tabular-nums">
        <thead class="border-y border-slate-200 bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th scope="col" class="px-4 sm:px-6 py-2 font-medium"><%= t(".day") %></th>
            <th scope="col" class="px-4 sm:px-6 py-2 text-right font-medium"><%= t(".high") %></th>
            <th scope="col" class="px-4 sm:px-6 py-2 text-right font-medium"><%= t(".low") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @result.forecast.days.each do |day| %>
            <tr>
              <td class="px-4 sm:px-6 py-3"><%= l(day.date, format: :forecast_day) %></td>
              <td class="px-4 sm:px-6 py-3 text-right font-medium"><%= t(".temperature", degrees: day.high.round) %></td>
              <td class="px-4 sm:px-6 py-3 text-right text-slate-500"><%= t(".temperature", degrees: day.low.round) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <% if @result.locations.size > 1 %>
        <%= form_with url: forecast_path,
                      method: :get,
                      class: "other-addresses border-t border-slate-200 bg-slate-50 p-6",
                      data: { controller: "auto-submit", turbo_action: "advance" } do |form| %>
          <%= form.hidden_field :address, value: @search.address %>
          <%= form.label :selected, t(".other_addresses"), class: "block text-sm font-medium text-slate-700" %>
          <div class="mt-2 flex flex-col gap-2 sm:flex-row">
            <%= form.select :selected,
                            @result.locations.each_with_index.map { |location, index| [ location.formatted_address, index ] },
                            { selected: @result.selected_index },
                            data: { action: "auto-submit#submit" },
                            class: "min-w-0 w-full flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/30" %>
            <noscript>
              <%= form.submit t(".show_forecast"), name: nil, class: "rounded-lg bg-white px-4 py-2 text-sm font-medium ring-1 ring-slate-300" %>
            </noscript>
          </div>
        <% end %>
      <% end %>
    </section>
  <% else %>
    <p class="error rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"><%= @result.error %></p>
  <% end %>
<% end %>
